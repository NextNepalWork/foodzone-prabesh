# Food Zone backend configuration
# Copy to .env and fill in real values. NEVER commit real credentials.

# ── Database (required) ────────────────────────────────────────────────
# Railway/Render style single URL (preferred):
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME
# …or discrete values (used when DATABASE_URL is unset):
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=restaurant_db
# DB_USER=postgres
# DB_PASSWORD=
# Set false only when PostgreSQL is on the same private Docker network.
# DB_SSL=true

# ── Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development
# Set true only when the app runs behind one trusted reverse proxy.
TRUST_PROXY=false

# ── Auth (required in production) ──────────────────────────────────────
# Long random string; server refuses to start in production without it.
JWT_SECRET=
JWT_EXPIRES_IN=24h
# Seeds the first Manager account when the staff table is empty.
INITIAL_MANAGER_USERNAME=admin
INITIAL_MANAGER_PASSWORD=

# ── Browser origins (comma-separated; white-label domains go here) ─────
ALLOWED_ORIGINS=https://yourrestaurant.com,https://www.yourrestaurant.com

# ── Web Push (VAPID) ───────────────────────────────────────────────────
# Generate with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# ── Email notifications (SMTP, e.g. Hostinger) ─────────────────────────
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
BOOKING_NOTIFY_EMAIL=
