# Copy this file to .env.hostinger on the Hostinger VPS. Never commit the real
# file. Values containing spaces or # characters should be quoted.

# Public backend hostname. Create an A record pointing this name to the VPS.
API_DOMAIN=api.foodzone.com.np
TLS_EMAIL=admin@foodzone.com.np

# PostgreSQL stays inside the VPS. Use a long unique password without URL
# encoding concerns; the app connects with separate DB_* variables.
POSTGRES_DB=foodzone
POSTGRES_USER=foodzone
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Keep the current production JWT secret and VAPID pair during migration so
# staff sessions and existing browser push subscriptions continue to work.
JWT_SECRET=replace-with-current-production-value
JWT_EXPIRES_IN=24h
ALLOWED_ORIGINS=https://foodzone.com.np,https://www.foodzone.com.np

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@foodzone.com.np

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
BOOKING_NOTIFY_EMAIL=

# Optional comma-separated administration IP allow-list.
ADMIN_IP_WHITELIST=

# Do not set INITIAL_MANAGER_PASSWORD when restoring the existing staff data.
